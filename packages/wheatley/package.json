{
  "name": "wheatley",
  "version": "0.0.0",
  "private": true,
  "description": "Wheatley daemon and CLI",
  "license": "ISC",
  "bin": {
    "wheatley": "bin/wheatley.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-dashboard.ts && node scripts/vendor-workspace-packages.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-durable": "1.6.1",
    "@earendil-works/pi-schema": "1.6.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@slack/socket-mode": "3.2.0",
    "@slack/web-api": "8.5.0",
    "croner": "11.0.1",
    "discord.js": "14.28.1",
    "grammy": "1.46.0",
    "import-meta-resolve": "4.2.0",
    "typebox": "1.4.7",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@types/ws": "8.18.1",
    "@wheatley/dashboard": "workspace:*",
    "@wheatley/protocol": "workspace:*",
    "@wheatley/sdk": "workspace:*"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
