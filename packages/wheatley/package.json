{
  "name": "wheatley",
  "version": "0.0.0",
  "private": true,
  "description": "Wheatley daemon and CLI",
  "license": "ISC",
  "bin": {
    "wheatley": "bin/wheatley.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json && node scripts/bundle-dashboard.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-durable": "1.6.1",
    "@earendil-works/pi-schema": "1.6.1",
    "@wheatley/protocol": "workspace:*",
    "@wheatley/sdk": "workspace:*",
    "typebox": "1.4.7"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
