{
  "name": "@wheatley-ai/cli",
  "version": "0.1.0",
  "description": "Wheatley daemon and CLI",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SphericalKat/wheatley.git",
    "directory": "packages/wheatley"
  },
  "bin": {
    "wheatley": "bin/wheatley.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-dashboard.ts && node scripts/vendor-workspace-packages.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-durable": "1.6.1",
    "@earendil-works/pi-schema": "1.6.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@slack/socket-mode": "3.2.0",
    "@slack/web-api": "8.5.0",
    "croner": "11.0.1",
    "discord.js": "14.28.1",
    "grammy": "1.48.0",
    "import-meta-resolve": "4.2.0",
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "typebox": "1.4.7",
    "wrap-ansi": "10.0.2",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@types/react": "19.3.1",
    "@types/ws": "8.18.2",
    "@wheatley-ai/dashboard": "workspace:*",
    "@wheatley-ai/protocol": "workspace:*",
    "@wheatley-ai/sdk": "workspace:*",
    "ink-testing-library": "4.0.0"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
