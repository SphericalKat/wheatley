{
  "name": "@wheatley-ai/plugin-web-search",
  "version": "0.0.0",
  "private": true,
  "description": "Bundled Wheatley Plugin that searches the web and fetches web pages",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "@wheatley/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "turndown": "7.2.5",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6",
    "@wheatley-ai/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@wheatley-ai/sdk": "workspace:*"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
