{
  "name": "wheatley-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "pnpm workspace for the Wheatley daemon, SDK, protocol, and dashboard",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2",
    "ultracite": "8.3.1",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
